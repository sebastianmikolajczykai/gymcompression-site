---
// Lista wszystkich wpisów: krótkie wiersze (data, tytuł, zajawka) z wyszukiwarką, każdy wpis ma własną stronę /<slug>/.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { posts, postPath, href, abs } from '../lib/shop';
import { breadcrumbLd, itemListLd } from '../lib/schema';
const crumbs = [{ name: 'Strona główna', path: '' }, { name: 'Blog', path: 'blog' }];
const fmt = (d: string) => new Date(d).toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', year: 'numeric' });
const topics = ['rashguard', 'legginsy', 'spodenki', 'zestaw', 'bluza', 'rozmiar', 'pranie', 'MMA', 'crossfit', 'bieganie']
  .filter((w) => posts.filter((p) => `${p.title} ${p.excerpt}`.toLowerCase().includes(w.toLowerCase())).length >= 3);
---
<Base title="Blog: odzież kompresyjna i trening | Gym Compression" description={`Blog Gym Compression: jak dobrać rozmiar, rashguard, legginsy i zestaw kompresyjny, jak prać odzież sportową. ${posts.length} artykułów.`} path="blog" activeNav="blog" plOnly
  jsonld={[breadcrumbLd(crumbs), { '@context': 'https://schema.org', '@type': 'Blog', '@id': 'https://gymcompression.pl/blog/#blog', name: 'Blog Gym Compression', url: abs('blog'), inLanguage: 'pl', publisher: { '@id': 'https://gymcompression.pl/#organization' } }, itemListLd(posts.slice(0, 30).map((p) => ({ url: abs(postPath(p)), name: p.title })))]}>
  <Breadcrumbs items={crumbs} />
  <header class="wrap blog-head">
    <h1>Blog</h1>
    <p class="blog-lead">Jak dobrać odzież kompresyjną, rozmiar i zestaw do swojego treningu. Wybierz temat albo wpisz, czego szukasz.</p>
    <div class="blog-tools" data-blog>
      <label class="blog-search"><span class="sr-only">Szukaj w poradniku</span>
        <input type="search" placeholder="Szukaj, np. rozmiar rashguardu" data-q autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label="Tematy">
        {topics.map((w) => <button type="button" class="chip" data-topic={w} aria-pressed="false">{w}</button>)}
      </div>
    </div>
  </header>
  <div class="wrap">
    <p class="mono count" aria-live="polite">Artykuły: <span data-count>{posts.length}</span></p>
    <ol class="plist" data-list>
      {posts.map((p) => (
        <li data-post data-text={`${p.title} ${p.excerpt}`.toLowerCase()}>
          <a href={href(postPath(p))}>
            <time class="mono" datetime={p.date.slice(0, 10)}>{fmt(p.date)}</time>
            <span class="plist__t"><strong>{p.title}</strong><span>{p.excerpt.length > 150 ? p.excerpt.slice(0, 150).replace(/\s+\S*$/, '') + '…' : p.excerpt}</span></span>
          </a>
        </li>
      ))}
    </ol>
    <p class="empty" data-empty hidden>Brak artykułów dla tego hasła. <button type="button" class="linkbtn" data-reset>Pokaż wszystkie</button></p>
  </div>
</Base>
<style>
  .blog-head { display: grid; gap: var(--s-4); padding-bottom: var(--s-5); }
  .blog-lead { color: var(--graphite); max-width: 60ch; font-size: var(--t-lg); }
  .blog-tools { display: grid; gap: var(--s-3); }
  .blog-search input { width: 100%; max-width: 34rem; height: 3.25rem; padding: 0 1.1rem; border: 1px solid var(--line); border-radius: 999px; font: inherit; background: var(--paper); color: var(--ink); }
  .blog-search input:focus { outline: 0; border-color: var(--tape); box-shadow: 0 0 0 3px color-mix(in srgb, var(--tape) 18%, transparent); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chip { padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); font-weight: 600; font-size: var(--t-sm); }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .count { color: var(--muted); font-size: var(--t-sm); padding-bottom: var(--s-3); }
  .plist { list-style: none; margin: 0 0 var(--s-8); padding: 0; border-bottom: 1px solid var(--line); }
  .plist li { border-top: 1px solid var(--line); }
  .plist a { display: grid; grid-template-columns: 7.5rem 1fr; gap: var(--s-4); padding: var(--s-4) 0; text-decoration: none; align-items: baseline; }
  .plist time { color: var(--muted); font-size: var(--t-sm); }
  .plist__t { display: grid; gap: .25rem; }
  .plist__t strong { font: 700 var(--t-lg)/1.25 var(--f-display); }
  .plist__t span { color: var(--muted); font-size: var(--t-sm); max-width: 80ch; }
  .plist a:hover strong { color: var(--tape); }
  .empty { padding: var(--s-6) 0 var(--s-8); color: var(--muted); }
  .linkbtn { background: none; border: 0; padding: 0; text-decoration: underline; color: var(--ink); }
  @media (max-width: 640px) { .plist a { grid-template-columns: 1fr; gap: .3rem; } .plist__t strong { font-size: var(--t-md); } }
</style>
<script is:inline>
  (function () {
    var q = document.querySelector('[data-q]'), items = [].slice.call(document.querySelectorAll('[data-post]')), count = document.querySelector('[data-count]'), empty = document.querySelector('[data-empty]'), chips = [].slice.call(document.querySelectorAll('[data-topic]'));
    function apply() {
      var words = q.value.toLowerCase().split(/\s+/).filter(Boolean), n = 0;
      items.forEach(function (li) { var ok = words.every(function (w) { return li.dataset.text.indexOf(w) > -1; }); li.hidden = !ok; if (ok) n++; });
      count.textContent = n; empty.hidden = n > 0;
      chips.forEach(function (c) { c.setAttribute('aria-pressed', String(q.value.toLowerCase() === c.dataset.topic.toLowerCase())); });
    }
    q.addEventListener('input', apply);
    chips.forEach(function (c) { c.addEventListener('click', function () { q.value = c.getAttribute('aria-pressed') === 'true' ? '' : c.dataset.topic; apply(); }); });
    document.querySelector('[data-reset]').addEventListener('click', function () { q.value = ''; apply(); q.focus(); });
  })();
</script>
