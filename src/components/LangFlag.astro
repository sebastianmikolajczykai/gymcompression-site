---
// Lekkie flagi inline SVG (emoji flag nie działają na Windows). Dekoracyjne: nazwę języka niesie tekst linku.
import type { Lang } from '../i18n';
const { lang, uid = '' } = Astro.props as { lang: Lang; uid?: string };
const clip = `gb-clip${uid}`; // unikalne id, bo przełącznik jest na stronie dwa razy (nagłówek i menu mobilne)
---
{lang === 'pl' && (
  <svg class="flag" viewBox="0 0 16 12" aria-hidden="true" focusable="false"><path fill="#fff" d="M0 0h16v6H0z"/><path fill="#DC143C" d="M0 6h16v6H0z"/></svg>
)}
{lang === 'uk' && (
  <svg class="flag" viewBox="0 0 16 12" aria-hidden="true" focusable="false"><path fill="#0057B7" d="M0 0h16v6H0z"/><path fill="#FFD700" d="M0 6h16v6H0z"/></svg>
)}
{lang === 'en' && (
  <svg class="flag" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><clipPath id={clip}><path d="M30 15h30v15zv15H0zH0V0zV0h30z"/></clipPath><path fill="#012169" d="M0 0v30h60V0z"/><path stroke="#fff" stroke-width="6" d="m0 0 60 30m0-30L0 30"/><path stroke="#C8102E" stroke-width="4" d="m0 0 60 30m0-30L0 30" clip-path={`url(#${clip})`}/><path stroke="#fff" stroke-width="10" d="M30 0v30M0 15h60"/><path stroke="#C8102E" stroke-width="6" d="M30 0v30M0 15h60"/></svg>
)}
