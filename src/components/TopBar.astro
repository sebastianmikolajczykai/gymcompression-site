---
// Pasek informacyjny nad nagłówkiem (wzorzec ze sklepów odzieżowych): tylko potwierdzone warunki sklepu.
// Dostawa: shipping w catalog.ts i strona „Wysyłka i dostawa”; 14 dni: ustawowe odstąpienie od umowy ze strony „Zwroty”.
import { href as hrefPl } from '../lib/shop';
import { langOf, t } from '../i18n';
const L = langOf(Astro.url.pathname);
---
<div class="topbar" role="note">
  <div class="wrap topbar__in">
    <a href={hrefPl('wysylka-i-dostawa')} hreflang="pl">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17.5" cy="17.5" r="1.6"/></svg>
      <strong>{t(L, 'Darmowa dostawa do Paczkomatu InPost i punktu DPD')}</strong>
    </a>
    <span class="topbar__more">{t(L, 'Wysyłka nawet tego samego dnia roboczego')}</span>
    <span class="topbar__more">{t(L, '14 dni na zwrot')}</span>
  </div>
</div>
<style>
  .topbar { background: var(--ink); color: var(--paper); font-size: var(--t-xs); }
  .topbar__in { display: flex; justify-content: center; align-items: center; gap: .4rem var(--s-6); min-height: 2.25rem; padding-block: .35rem; text-align: center; }
  .topbar a { display: inline-flex; align-items: center; gap: .45rem; color: inherit; text-decoration: none; }
  .topbar a:hover strong { text-decoration: underline; }
  .topbar strong { font-weight: 600; }
  .topbar svg { flex: none; width: 1.1rem; height: 1.1rem; }
  .topbar__more { opacity: .8; }
  .topbar__more::before { content: "·"; margin-right: var(--s-6); opacity: .6; }
  @media (max-width: 760px) { .topbar__more { display: none; } }
</style>
