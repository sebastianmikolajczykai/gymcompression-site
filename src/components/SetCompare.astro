---
// Porównanie zestawów 2w1–7w1: co oznacza liczba i jakie elementy są w komplecie.
// Tabela liczy się z danych produktów (setItems), więc zmienia się razem z ofertą.
import { byPath } from '../data/catalog';
import { inCollection, href as hrefPl, pln as plnPl } from '../lib/shop';
import { langOf, t, tf, plural } from '../i18n';
const L = langOf(Astro.url.pathname);
const href = (p: string) => hrefPl(p, L);
const { open = false } = Astro.props as { open?: boolean };

const ROWS = [
  { key: 'short', label: 'Koszulka lub rashguard z krótkim rękawem' },
  { key: 'long', label: 'Rashguard z długim rękawem' },
  { key: 'shorts', label: 'Spodenki sportowe' },
  { key: 'legs', label: 'Legginsy (spodnie kompresyjne)' },
  { key: 'hoodie', label: 'Bluza' },
  { key: 'tank', label: 'Bokserka sportowa' },
  { key: 'cshorts', label: 'Spodenki kompresyjne' },
] as const;
function classify(item: string): string {
  const s = item.toLowerCase();
  if (s.includes('bluza')) return 'hoodie';
  if (s.includes('bokserka')) return 'tank';
  if (s.includes('długim rękawem')) return 'long';
  if (s.includes('spodenki kompresyjne')) return 'cshorts';
  if (/^(spodenki|szorty)/.test(s)) return 'shorts';
  if (s.includes('legginsy') || s.includes('spodnie kompresyjne')) return 'legs';
  return 'short';
}
const SUMMARY: Record<string, string> = {
  '2w1': 'Góra i spodenki. Najprostszy start z kompresją.',
  '3w1': 'Góra, spodenki i legginsy.',
  '4w1': 'Krótki i długi rękaw, legginsy i spodenki.',
  '5w1': 'Jak 4w1 plus bluza na chłodniejsze dni.',
  '7w1': 'Najpełniejszy komplet: dochodzi bokserka i spodenki kompresyjne.',
};
const sets = ['2w1', '3w1', '4w1', '5w1', '7w1'].map((n) => {
  const col = byPath(`zestawy-kompresyjne/${n}`)!;
  const items = inCollection(col);
  const has: Record<string, number> = {};
  for (const p of items) for (const k of new Set(p.setItems.map(classify))) has[k] = (has[k] || 0) + 1;
  return { n, k: Number(n[0]), col, count: items.length, has, from: items.length ? Math.min(...items.map((p) => p.price)) : 0 };
}).filter((s) => s.count);
const label = (n: string) => (L === 'en' ? n.replace('w', '-in-') : L === 'uk' ? n.replace('w', ' в ') : n);
---
<details class="cmp" id="porownaj-zestawy" open={open}>
  <summary><span class="cmp__q">{t(L, 'Co znaczy 2w1, 3w1, 5w1? Porównaj zestawy')}</span><span class="cmp__ic" aria-hidden="true"></span></summary>
  <div class="cmp__body">
    <p class="cmp__lead">{t(L, 'Liczba przed „w1” to liczba elementów w komplecie: 2w1 to dwa elementy, 5w1 to pięć. Każdy element możesz nosić osobno albo razem z pozostałymi.')}</p>
    <div class="cmp__scroll" role="region" aria-label={t(L, 'Porównanie zestawów')} tabindex="0">
      <table class="cmp__t">
        <thead>
          <tr>
            <th scope="col">{t(L, 'W zestawie')}</th>
            {sets.map((s) => <th scope="col"><a href={href(s.col.path)}>{label(s.n)}</a></th>)}
          </tr>
        </thead>
        <tbody>
          {ROWS.filter((r) => sets.some((s) => s.has[r.key])).map((r) => (
            <tr>
              <th scope="row">{t(L, r.label)}</th>
              {sets.map((s) => {
                const c = s.has[r.key] || 0;
                return <td class={c ? 'y' : 'n'}>{c === s.count ? <span class="tick" aria-label={t(L, 'tak')}>✓</span> : c ? <span class="some">{tf(L, 'w {a} z {b} wzorów', { a: c, b: s.count })}</span> : <span aria-label={t(L, 'nie')}>–</span>}</td>;
              })}
            </tr>
          ))}
          <tr class="cmp__sum">
            <th scope="row">{t(L, 'W skrócie')}</th>
            {sets.map((s) => <td>{t(L, SUMMARY[s.n])}</td>)}
          </tr>
          <tr class="cmp__buy">
            <th scope="row">{t(L, 'Cena')}</th>
            {sets.map((s) => <td><span class="mono">{t(L, 'od')} {plnPl(s.from, L)}</span><a class="link-arrow" href={href(s.col.path)}>{s.count} {plural(L, s.count, ['wzór', 'wzory', 'wzorów'])}</a></td>)}
          </tr>
        </tbody>
      </table>
    </div>
    <p class="cmp__note">{t(L, 'Dokładny skład każdego wzoru jest na stronie produktu w sekcji „W zestawie”.')}</p>
  </div>
</details>
<style>
  .cmp { border: 1px solid var(--line); border-radius: 14px; background: var(--paper); }
  .cmp summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-4) var(--s-5); font-weight: 700; font-size: var(--t-lg); }
  .cmp summary::-webkit-details-marker { display: none; }
  .cmp summary:hover .cmp__q { color: var(--tape); }
  .cmp__ic { flex: none; width: 2.25rem; height: 2.25rem; border-radius: 999px; background: var(--ink); position: relative; }
  .cmp__ic::before, .cmp__ic::after { content: ""; position: absolute; inset: 50% auto auto 50%; width: .9rem; height: 2px; background: var(--paper); transform: translate(-50%, -50%); transition: transform .15s; }
  .cmp__ic::after { transform: translate(-50%, -50%) rotate(90deg); }
  .cmp[open] .cmp__ic::after { transform: translate(-50%, -50%); }
  .cmp__body { display: grid; gap: var(--s-4); padding: 0 var(--s-5) var(--s-5); }
  .cmp__lead { max-width: 70ch; color: var(--graphite); }
  .cmp__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-inline: calc(-1 * var(--s-5)); padding-inline: var(--s-5); }
  .cmp__t { border-collapse: collapse; width: 100%; min-width: 42rem; font-size: var(--t-sm); }
  .cmp__t th, .cmp__t td { padding: .7rem .6rem; border-top: 1px solid var(--line); text-align: center; vertical-align: top; }
  .cmp__t thead th { border-top: 0; font: 800 var(--t-lg)/1 var(--f-display); font-stretch: 112%; }
  .cmp__t thead th:first-child { font: 600 var(--t-xs)/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); vertical-align: bottom; }
  .cmp__t thead a { text-decoration: none; }
  .cmp__t tbody th { text-align: left; font-weight: 600; min-width: 11rem; }
  .cmp__t th:first-child { position: sticky; left: 0; background: var(--paper); text-align: left; }
  .cmp__t .tick { color: var(--ok); font-weight: 800; font-size: 1.1rem; }
  .cmp__t .n { color: var(--line); }
  .cmp__t .some { color: var(--muted); font-size: var(--t-xs); }
  .cmp__sum td { color: var(--graphite); text-align: left; min-width: 9rem; }
  .cmp__buy td { display: table-cell; }
  .cmp__buy td .mono { display: block; font-weight: 600; margin-bottom: .3rem; }
  .cmp__note { color: var(--muted); font-size: var(--t-sm); }
  @media (max-width: 560px) { .cmp__t { min-width: 34rem; } .cmp__t tbody th { min-width: 8.5rem; } .cmp__t th, .cmp__t td { padding: .6rem .4rem; } .cmp__sum td { min-width: 7.5rem; } .cmp summary { font-size: var(--t-md); padding: var(--s-4); } .cmp__body { padding: 0 var(--s-4) var(--s-4); } .cmp__scroll { margin-inline: calc(-1 * var(--s-4)); padding-inline: var(--s-4); } }
</style>
