---
// Krótkie wyjaśnienie zestawów 2w1–7w1: co oznacza liczba i jedno zdanie o każdym zestawie z ceną i linkiem.
import { byPath } from '../data/catalog';
import { inCollection, href as hrefPl, pln as plnPl } from '../lib/shop';
import { langOf, t, plural } from '../i18n';
const L = langOf(Astro.url.pathname);
const href = (p: string) => hrefPl(p, L);
const { open = false } = Astro.props as { open?: boolean };

const SUMMARY: Record<string, string> = {
  '2w1': 'Góra i spodenki. Największy klasyk.',
  '3w1': 'Góra, spodenki i legginsy.',
  '4w1': 'Krótki i długi rękaw, legginsy i spodenki.',
  '5w1': 'Jak 4w1 plus bluza na chłodniejsze dni.',
  '7w1': 'Najpełniejszy komplet. Dochodzą bokserka i spodenki kompresyjne.',
};
const sets = ['2w1', '3w1', '4w1', '5w1', '7w1'].map((n) => {
  const col = byPath(`zestawy-kompresyjne/${n}`)!;
  const items = inCollection(col);
  return { n, col, count: items.length, from: items.length ? Math.min(...items.map((p) => p.price)) : 0 };
}).filter((s) => s.count);
const label = (n: string) => (L === 'en' ? n.replace('w', '-in-') : L === 'uk' ? n.replace('w', ' в ') : n);
---
<details class="cmp" id="porownaj-zestawy" open={open}>
  <summary><span class="cmp__q">{t(L, 'Co znaczy 2w1, 3w1, 5w1? Porównaj zestawy')}</span><span class="cmp__ic" aria-hidden="true"></span></summary>
  <div class="cmp__body">
    <p class="cmp__lead">{t(L, 'Liczba przed „w1” to liczba elementów w komplecie: 2w1 to dwa elementy, 5w1 to pięć. Każdy element możesz nosić osobno albo razem z pozostałymi.')}</p>
    <ul class="cmp__list">
      {sets.map((s) => (
        <li>
          <a href={href(s.col.path)}>
            <strong class="cmp__n">{label(s.n)}</strong>
            <span class="cmp__d">{t(L, SUMMARY[s.n])}</span>
            <span class="cmp__p"><span class="mono">{t(L, 'od')} {plnPl(s.from, L)}</span><span class="link-arrow">{s.count} {plural(L, s.count, ['wzór', 'wzory', 'wzorów'])}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>
<style>
  .cmp { border: 1px solid var(--line); border-radius: 14px; background: var(--paper); }
  .cmp summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-4) var(--s-5); font-weight: 700; font-size: var(--t-lg); }
  .cmp summary::-webkit-details-marker { display: none; }
  .cmp summary:hover .cmp__q { color: var(--tape); }
  .cmp__ic { flex: none; width: 2.25rem; height: 2.25rem; border-radius: 999px; background: var(--ink); position: relative; }
  .cmp__ic::before, .cmp__ic::after { content: ""; position: absolute; inset: 50% auto auto 50%; width: .9rem; height: 2px; background: var(--paper); transform: translate(-50%, -50%); transition: transform .15s; }
  .cmp__ic::after { transform: translate(-50%, -50%) rotate(90deg); }
  .cmp[open] .cmp__ic::after { transform: translate(-50%, -50%); }
  .cmp__body { display: grid; gap: var(--s-4); padding: 0 var(--s-5) var(--s-5); }
  .cmp__lead { max-width: 70ch; color: var(--graphite); }
  .cmp__list { list-style: none; margin: 0; padding: 0; }
  .cmp__list li { border-top: 1px solid var(--line); }
  .cmp__list a { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: var(--s-4); align-items: center; padding: var(--s-4) 0; text-decoration: none; }
  .cmp__n { font: 800 var(--t-xl)/1 var(--f-display); font-stretch: 112%; }
  .cmp__d { color: var(--graphite); }
  .cmp__p { display: grid; gap: .2rem; justify-items: end; font-size: var(--t-sm); white-space: nowrap; }
  .cmp__p .mono { font-weight: 600; }
  .cmp__list a:hover .cmp__n { color: var(--tape); }
  @media (max-width: 560px) {
    .cmp summary { font-size: var(--t-md); padding: var(--s-4); } .cmp__body { padding: 0 var(--s-4) var(--s-4); }
    .cmp__list a { grid-template-columns: 3.5rem 1fr; gap: .4rem var(--s-3); }
    .cmp__p { grid-column: 2; justify-items: start; grid-auto-flow: column; justify-content: start; gap: var(--s-4); }
  }
</style>
