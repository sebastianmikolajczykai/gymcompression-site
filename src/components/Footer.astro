---
import { company, collections } from '../data/catalog';
import { href as hrefPl } from '../lib/shop';
import { langOf, t } from '../i18n';
const L = langOf(Astro.url.pathname);
const href = (p: string) => hrefPl(p, L);
const plOnly = L !== 'pl' ? ` (${t(L, 'po polsku')})` : '';
const shop = ['odziez-kompresyjna-meska', 'odziez-kompresyjna-damska', 'zestawy-kompresyjne', 'zestawy-kompresyjne/spartan', 'rashguardy', 'legginsy-kompresyjne', 'spodenki-kompresyjne', 'bluzy-kompresyjne'].map((p) => collections.find((c) => c.path === p)!);
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div style="display:grid;gap:1rem;align-content:start">
        <a class="logo" href={href('')}><img src="/img/logo-white.png" width="360" height="108" alt="Gym Compression" loading="lazy" /></a>
        <p style="max-width:34ch;font-size:.9rem">{t(L, 'Odzież kompresyjna i termoaktywna na siłownię, sporty walki, crossfit i bieganie.')}</p>
      </div>
      <div>
        <h2>{t(L, 'Sklep')}</h2>
        <ul>{shop.map((c) => <li><a href={href(c.path)}>{t(L, c.name)}</a></li>)}</ul>
      </div>
      <div>
        <h2>{t(L, 'Pomoc')}</h2>
        <ul>
          <li><a href={href('tabela-rozmiarow')}>{t(L, 'Tabela rozmiarów')}</a></li>
          <li><a href={hrefPl('blog')} hreflang="pl">{t(L, 'Blog')}{plOnly}</a></li>
          <li><a href={hrefPl('wysylka-i-dostawa')} hreflang="pl">{t(L, 'Wysyłka i dostawa')}{plOnly}</a></li>
          <li><a href={hrefPl('refund_returns')} hreflang="pl">{t(L, 'Zwroty i reklamacje')}{plOnly}</a></li>
          <li><a href={hrefPl('regulamin')} hreflang="pl">{t(L, 'Regulamin')}{plOnly}</a></li>
          <li><a href={hrefPl('polityka-prywatnosci')} hreflang="pl">{t(L, 'Polityka prywatności')}{plOnly}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t(L, 'Kontakt')}</h2>
        <ul>
          <li>{company.street}<br />{company.postal} {company.city}</li>
          <li class="mono">{company.phone}</li>
          <li class="mono">{company.email}</li>
        </ul>
      </div>
    </div>
    <div class="ftr__base">
      <span>© {year} Gym Compression</span>
      <span>{t(L, 'Płatności online: Przelewy24')}</span>
    </div>
  </div>
</footer>
